{
  "schemaVersion": 1,
  "id": "glass-info",
  "name": "Glass Info",
  "version": "0.5.0",
  "apiVersion": 1,
  "minAndroidSdk": 24,
  "minAppVersion": "2026.11.14",
  "entryClass": "com.davidteles.ks.glassinfo.GlassInfoPlugin",
  "description": "A calm glass info screensaver: clock, weather, inside temperature, the next events and your alerts in one panel, fed live by Home Assistant.",
  "author": "davidteles",
  "license": "Apache-2.0",
  "capabilities": [
    "screensaver",
    "screensaver.mode",
    "ha",
    "host.read",
    "overlay"
  ],
  "icon": "icon.png",
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "title": "Look",
      "default": "Black",
      "options": [
        "Black",
        "Midnight"
      ],
      "group": "Look",
      "description": "Black is pure black for night and OLED-like calm; Midnight adds a very dark blue glow."
    },
    {
      "key": "accent",
      "type": "color",
      "title": "Accent color",
      "default": "#FFB547",
      "group": "Look",
      "description": "Used for the date line and the event bars."
    },
    {
      "key": "clock24",
      "type": "boolean",
      "title": "24-hour clock",
      "default": true,
      "group": "Look"
    },
    {
      "key": "hideWidgets",
      "type": "boolean",
      "title": "Hide the stock widgets",
      "default": true,
      "group": "Look",
      "description": "While Glass Info is on screen, the corner widgets and At a Glance row are drawn in black so only the panel shows. Other screensavers keep them."
    },
    {
      "key": "weatherEntity",
      "type": "entity",
      "title": "Weather",
      "default": "",
      "group": "Home Assistant",
      "description": "A weather entity, such as weather.home."
    },
    {
      "key": "insideEntity",
      "type": "entity",
      "title": "Inside temperature",
      "default": "",
      "group": "Home Assistant",
      "description": "Optional. A sensor whose state is shown as 'inside'."
    },
    {
      "key": "infoEntity",
      "type": "entity",
      "title": "Alerts line",
      "default": "",
      "group": "Home Assistant",
      "description": "Optional. A sensor whose state lists alerts separated by ' · '. Each one becomes a chip; empty shows none."
    },
    {
      "key": "calendar1",
      "type": "entity",
      "title": "Calendar 1",
      "default": "",
      "group": "Events"
    },
    {
      "key": "calendar2",
      "type": "entity",
      "title": "Calendar 2",
      "default": "",
      "group": "Events"
    },
    {
      "key": "days",
      "type": "number",
      "title": "Days ahead",
      "default": 3,
      "min": 1,
      "max": 7,
      "step": 1,
      "unit": "days",
      "group": "Events"
    },
    {
      "key": "maxEvents",
      "type": "number",
      "title": "Maximum events",
      "default": 4,
      "min": 1,
      "max": 6,
      "step": 1,
      "group": "Events"
    },
    {
      "key": "dayWidgets",
      "type": "boolean",
      "title": "Glass widgets over other screensavers",
      "default": true,
      "group": "Day widgets",
      "description": "Draws our clock, weather, next events and chips over the photo screensaver (any mode except Glass Info itself)."
    },
    {
      "key": "glance1",
      "type": "entity",
      "title": "Chip 1",
      "default": "",
      "group": "Day widgets"
    },
    {
      "key": "glance1Name",
      "type": "string",
      "title": "Chip 1 name",
      "default": "",
      "group": "Day widgets"
    },
    {
      "key": "glance2",
      "type": "entity",
      "title": "Chip 2",
      "default": "",
      "group": "Day widgets"
    },
    {
      "key": "glance2Name",
      "type": "string",
      "title": "Chip 2 name",
      "default": "",
      "group": "Day widgets"
    },
    {
      "key": "glance3",
      "type": "entity",
      "title": "Chip 3",
      "default": "",
      "group": "Day widgets"
    },
    {
      "key": "glance3Name",
      "type": "string",
      "title": "Chip 3 name",
      "default": "",
      "group": "Day widgets"
    },
    {
      "key": "glance4",
      "type": "entity",
      "title": "Chip 4",
      "default": "",
      "group": "Day widgets"
    },
    {
      "key": "glance4Name",
      "type": "string",
      "title": "Chip 4 name",
      "default": "",
      "group": "Day widgets"
    },
    {
      "key": "nowPlayingStrip",
      "type": "boolean",
      "title": "Clock and weather beside Now Playing",
      "default": true,
      "group": "Day widgets",
      "description": "While the full-screen Now Playing player shows, a big clock and the weather sit either side of the cover, with your alerts in a slim pill at the top."
    },
    {
      "key": "showClock",
      "type": "boolean",
      "title": "Show the clock card",
      "default": true,
      "group": "Day layout"
    },
    {
      "key": "clockPosition",
      "type": "select",
      "title": "Clock position",
      "default": "Top left",
      "options": [
        "Top left",
        "Top right",
        "Bottom left",
        "Bottom right"
      ],
      "group": "Day layout"
    },
    {
      "key": "showWeather",
      "type": "boolean",
      "title": "Show the weather card",
      "default": true,
      "group": "Day layout"
    },
    {
      "key": "weatherPosition",
      "type": "select",
      "title": "Weather position",
      "default": "Top right",
      "options": [
        "Top left",
        "Top right",
        "Bottom left",
        "Bottom right"
      ],
      "group": "Day layout"
    },
    {
      "key": "showEvents",
      "type": "boolean",
      "title": "Show the events card",
      "default": true,
      "group": "Day layout"
    },
    {
      "key": "eventsPosition",
      "type": "select",
      "title": "Events position",
      "default": "Bottom left",
      "options": [
        "Top left",
        "Top right",
        "Bottom left",
        "Bottom right"
      ],
      "group": "Day layout",
      "description": "Cards in the same corner stack."
    },
    {
      "key": "showChips",
      "type": "boolean",
      "title": "Show alerts and chips",
      "default": true,
      "group": "Day layout"
    },
    {
      "key": "alertsStyle",
      "type": "select",
      "title": "Alerts style",
      "default": "Chips",
      "options": [
        "Chips",
        "Info line"
      ],
      "group": "Day layout",
      "description": "Info line = one line of text along the edge, like the iPad Panel's screensaver."
    },
    {
      "key": "chipsPosition",
      "type": "select",
      "title": "Alerts position",
      "default": "Bottom centre",
      "options": [
        "Bottom centre",
        "Top centre"
      ],
      "group": "Day layout"
    },
    {
      "key": "scale",
      "type": "number",
      "title": "Size",
      "default": 100,
      "min": 60,
      "max": 180,
      "step": 10,
      "unit": "%",
      "group": "Day look",
      "description": "Scales every day card, text included."
    },
    {
      "key": "cardOpacity",
      "type": "number",
      "title": "Card darkness",
      "default": 46,
      "min": 0,
      "max": 90,
      "step": 2,
      "unit": "%",
      "group": "Day look",
      "description": "0 = text only, no glass."
    },
    {
      "key": "clockWeight",
      "type": "select",
      "title": "Clock font weight",
      "default": "Light",
      "options": [
        "Light",
        "Regular",
        "Bold"
      ],
      "group": "Day look"
    }
  ]
}